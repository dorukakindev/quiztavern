# Bu dosyayı .env olarak kopyalayıp doldurun (server/.env — açılışta otomatik yüklenir).

# YEREL GELİŞTİRME: Discord'suz, sahte kimlik + botlarla oynamak için 1 yapın.
# Güvenlik sınırı budur; tanımsız/0 iken sunucu üretim duruşundadır (fail-closed):
# geçerli Discord oturumu + Activity Instance doğrulaması olmadan kimse bağlanamaz.
# Secret'ların varlığına/yokluğuna göre KENDİLİĞİNDEN AÇILMAZ.
ALLOW_MOCK_AUTH=

# ÜRETİM: hepsi zorunlu. Discord Developer Portal > Applications > (uygulamanız)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot sekmesinden. Activity Instance doğrulaması bu token'sız fail-closed reddeder.
DISCORD_BOT_TOKEN=

# Oturum imzalama anahtarı — uzun rastgele bir dize girin (openssl rand -hex 32)
SESSION_SECRET=

# Production guards. Browser OAuth always derives its callback from this URL.
# NODE_ENV=production
PUBLIC_BASE_URL=https://quiztavern.SENIN-ALAN-ADIN.com
# Optional comma-separated browser origins you control.
ALLOWED_ORIGINS=

PORT=3001
# Cloudflare Tunnel aynı makinedeyse loopback güvenli varsayılandır.
# Docker/Render/Railway gibi ortamlarda açıkça HOST=0.0.0.0 verin.
HOST=127.0.0.1
