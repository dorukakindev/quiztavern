# Triviara — kanonik ortam değişkeni listesi (TEK KAYNAK).
# fly.toml / railway.toml / render.yaml / deploy/oracle / docs/DEPLOY.md
# bu listeyle uyumlu tutulur; yeni değişken önce buraya eklenir.

# ── Zorunlu (sunucu) ────────────────────────────────────────────────────
# DISCORD_CLIENT_ID        Discord application id
# DISCORD_CLIENT_SECRET    OAuth client secret
# DISCORD_BOT_TOKEN        guild instance doğrulaması
# SESSION_SECRET           oturum imzası — bir kez üret, sabit tut
#                          (openssl rand -hex 32; değişirse oturumlar düşer)
# PUBLIC_BASE_URL          https://<host> — OAuth redirect buradan türer

# ── Build-arg (client'a imajda gömülür) ─────────────────────────────────
# VITE_DISCORD_CLIENT_ID   DISCORD_CLIENT_ID ile aynı değer

# ── Platformun enjekte ettiği ───────────────────────────────────────────
# PORT                     fly.toml'da 8080 sabit; Railway/Render verir
# HOST                     0.0.0.0

# ── Kalıcı disk mount yolu (tüm platformlarda aynı) ─────────────────────
# /app/server/data         xp.db, daily.db, question-reports.db, packs.db

# ── Opsiyonel ───────────────────────────────────────────────────────────
# QT_ADMIN_TOKEN           /admin/reports paneli Bearer token'ı
# ALLOW_MOCK_AUTH          YALNIZ yerel geliştirme — prod'a ASLA eklenmez
# ALLOW_GUEST_AUTH         web misafiri (Discord'suz tarayıcı) — varsayılan
#                          AÇIK; kapatmak için =0. Misafirler `guest:` öneklidir
#                          ve yalnız `web-` odalarına girer.
# DISCORD_GATEWAY          /triviara slash komutunu cevaplayan minimal
#                          gateway bağlantısı — varsayılan açık; kapatmak =0
# ALLOWED_ORIGINS          virgüllü ek origin listesi; PUBLIC_BASE_URL
#                          otomatik eklenir (domain bağlanınca tek satır
#                          güncellemek yeterli)
