# Kopyala: client/.env — Vite build/dev sırasında okunur.
#
# UYARI: VITE_ önekli HER değişken istemci bundle'ına gömülür ve herkese
# görünür. Buraya asla secret koyma (client_secret, bot token, session secret
# SUNUCUNUN .env dosyasına gider, bkz. server/.env.example).

# Discord Developer Portal > Applications > (dev uygulaman) > OAuth2 > Client ID.
# Boşsa istemci Discord'a hiç dokunmaz, yerel mock modda çalışır.
VITE_DISCORD_CLIENT_ID=

# Oyun sunucusunun adresi. Yerel geliştirmede boş bırak (localhost:3001).
# Discord smoke testinde: sunucu tüneli URL'si (ör. https://xxx.trycloudflare.com)
VITE_GAME_SERVER_URL=
