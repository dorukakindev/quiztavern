{
  "name": "quiztavern",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "test": "node scripts/run-tests.mjs",
    "test:validate-questions": "tsx tools/validate-questions.ts",
    "test:timeline": "tsx server/scripts/timeline-test.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
